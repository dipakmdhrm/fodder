# --- Rust / Cargo (linux/) -------------------------------------------------
/linux/target

# Backup files from rustfmt and editors
**/*.rs.bk
*.swp
*~

# Debug symbols
*.pdb

# --- Android / Gradle (android/) -------------------------------------------
/android/.gradle
/android/build
/android/app/build
/android/local.properties
/android/.kotlin
/android/.env
/android/captures

# Signing material must never be committed; CI decodes it from a secret.
*.keystore
*.jks

# Local editor / OS cruft
/.idea
/.vscode
*.iml
.DS_Store

# Release/packaging build output (produced locally when testing packaging)
/linux/rpmbuild
/linux/arch-build
/linux/gh-pages-dir
/linux/build-dir
/linux/.flatpak-builder
/linux/repo
/linux/pages
*.deb
*.rpm
*.pkg.tar.zst
*.flatpak
